    <rect width="120" height="120" fill="url(#g-inf)"/>
    <defs><linearGradient id="g-inf" x1="0" y1="0" x2="120" y2="120"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
    <g opacity="0.15" stroke="#fff" stroke-width="0.8">
      <line x1="10" y1="10" x2="10" y2="110"/><line x1="32" y1="10" x2="32" y2="110"/><line x1="54" y1="10" x2="54" y2="110"/><line x1="76" y1="10" x2="76" y2="110"/><line x1="98" y1="10" x2="98" y2="110"/>
      <line x1="10" y1="10" x2="110" y2="10"/><line x1="10" y1="32" x2="110" y2="32"/><line x1="10" y1="54" x2="110" y2="54"/><line x1="10" y1="76" x2="110" y2="76"/><line x1="10" y1="98" x2="110" y2="98"/>
    </g>
    <g fill="#fff" opacity="0.3">
      <circle cx="10" cy="10" r="2.5"/><circle cx="54" cy="10" r="2.5"/><circle cx="98" cy="10" r="2.5"/>
      <circle cx="32" cy="32" r="2.5"/><circle cx="76" cy="32" r="2.5"/>
      <circle cx="10" cy="54" r="2.5"/><circle cx="54" cy="54" r="2.5"/><circle cx="98" cy="54" r="2.5"/>
      <circle cx="32" cy="76" r="2.5"/><circle cx="76" cy="76" r="2.5"/>
      <circle cx="10" cy="98" r="2.5"/><circle cx="54" cy="98" r="2.5"/><circle cx="98" cy="98" r="2.5"/>
    </g>
    <g opacity="0.2" fill="none" stroke="#fff" stroke-width="1.2">
      <path d="M32 10 L54 32 L32 54 L10 32 Z"/><path d="M76 32 L98 54 L76 76 L54 54 Z"/>
      <path d="M32 54 L54 76 L32 98 L10 76 Z"/><path d="M76 76 L98 98"/><path d="M54 10 L76 32"/>
    </g>
  </svg>`,
  happyguest: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="120" height="120" fill="url(#g-hg)"/>
    <defs><linearGradient id="g-hg" x1="120" y1="0" x2="0" y2="120"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
    <g fill="#fff" opacity="0.15">
      <circle cx="60" cy="25" r="4"/><circle cx="30" cy="50" r="4"/><circle cx="60" cy="50" r="4"/><circle cx="90" cy="50" r="4"/>
      <circle cx="15" cy="75" r="4"/><circle cx="45" cy="75" r="4"/><circle cx="75" cy="75" r="4"/><circle cx="105" cy="75" r="4"/>
      <circle cx="30" cy="95" r="3"/><circle cx="60" cy="95" r="3"/><circle cx="90" cy="95" r="3"/>
    </g>
    <g stroke="#fff" stroke-width="0.6" opacity="0.2">
      <line x1="60" y1="25" x2="30" y2="50"/><line x1="60" y1="25" x2="60" y2="50"/><line x1="60" y1="25" x2="90" y2="50"/>
      <line x1="30" y1="50" x2="15" y2="75"/><line x1="30" y1="50" x2="45" y2="75"/>
      <line x1="60" y1="50" x2="45" y2="75"/><line x1="60" y1="50" x2="75" y2="75"/>
      <line x1="90" y1="50" x2="75" y2="75"/><line x1="90" y1="50" x2="105" y2="75"/>
      <line x1="15" y1="75" x2="30" y2="95"/><line x1="45" y1="75" x2="60" y2="95"/>
      <line x1="75" y1="75" x2="90" y2="95"/><line x1="45" y1="75" x2="30" y2="95"/><line x1="75" y1="75" x2="60" y2="95"/>
    </g>
  </svg>`,
  belieff: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="120" height="120" fill="url(#g-bf)"/>
    <defs><linearGradient id="g-bf" x1="60" y1="0" x2="60" y2="120"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
    <g fill="#fff" opacity="0.2">
      <circle cx="60" cy="25" r="5"/><circle cx="30" cy="55" r="4"/><circle cx="60" cy="55" r="4"/><circle cx="90" cy="55" r="4"/>
      <circle cx="15" cy="80" r="3.5"/><circle cx="45" cy="80" r="3.5"/><circle cx="75" cy="80" r="3.5"/><circle cx="105" cy="80" r="3.5"/>
      <circle cx="30" cy="100" r="3"/><circle cx="60" cy="100" r="3"/><circle cx="90" cy="100" r="3"/>
    </g>
    <g stroke="#fff" stroke-width="0.6" opacity="0.15">
      <line x1="60" y1="25" x2="30" y2="55"/><line x1="60" y1="25" x2="60" y2="55"/><line x1="60" y1="25" x2="90" y2="55"/>
      <line x1="30" y1="55" x2="15" y2="80"/><line x1="30" y1="55" x2="45" y2="80"/>
      <line x1="60" y1="55" x2="45" y2="80"/><line x1="60" y1="55" x2="75" y2="80"/>
      <line x1="90" y1="55" x2="75" y2="80"/><line x1="90" y1="55" x2="105" y2="80"/>
      <line x1="15" y1="80" x2="30" y2="100"/><line x1="45" y1="80" x2="60" y2="100"/>
      <line x1="75" y1="80" x2="90" y2="100"/>
    </g>
  </svg>`,
  derby: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="120" height="120" fill="url(#g-db)"/>
    <defs><linearGradient id="g-db" x1="0" y1="120" x2="120" y2="0"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
    <g fill="none" stroke="#fff" stroke-width="0.8" opacity="0.18">
      <path d="M10 60 L35 45 L60 60 L85 40 L110 60"/>
      <path d="M10 80 L35 65 L60 80 L85 60 L110 80"/>
      <path d="M10 100 L35 85 L60 100 L85 80 L110 100"/>
      <path d="M35 45 L35 65 L35 85"/><path d="M60 60 L60 80 L60 100"/>
      <path d="M85 40 L85 60 L85 80"/>
    </g>
    <g fill="#fff" opacity="0.2">
      <circle cx="35" cy="45" r="3"/><circle cx="60" cy="60" r="3"/><circle cx="85" cy="40" r="3"/>
      <circle cx="35" cy="85" r="2.5"/><circle cx="60" cy="100" r="2.5"/><circle cx="85" cy="80" r="2.5"/>
      <circle cx="10" cy="60" r="2"/><circle cx="10" cy="80" r="2"/><circle cx="10" cy="100" r="2"/>
      <circle cx="110" cy="60" r="2"/><circle cx="110" cy="80" r="2"/><circle cx="110" cy="100" r="2"/>
    </g>
    <g fill="#fff" opacity="0.12">
      <rect x="30" y="40" width="10" height="10" rx="2"/><rect x="55" y="55" width="10" height="10" rx="2"/>
      <rect x="80" y="35" width="10" height="10" rx="2"/><rect x="30" y="80" width="8" height="8" rx="2"/>
      <rect x="55" y="95" width="8" height="8" rx="2"/><rect x="80" y="75" width="8" height="8" rx="2"/>
    </g>
  </svg>`,
  adc: `<svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect width="120" height="120" fill="url(#g-adc)"/>
    <defs><linearGradient id="g-adc" x1="120" y1="120" x2="0" y2="0"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
    <g fill="none" stroke="#fff" stroke-width="0.8" opacity="0.15">
      <rect x="8" y="8" width="50" height="50" rx="4" transform="rotate(6 33 33)"/>
      <rect x="55" y="30" width="50" height="50" rx="4" transform="rotate(-4 80 55)"/>
      <rect x="20" y="55" width="50" height="50" rx="4" transform="rotate(3 45 80)"/>
    </g>
    <g fill="#fff" opacity="0.2">
      <circle cx="33" cy="33" r="3.5"/><circle cx="80" cy="55" r="3"/><circle cx="45" cy="80" r="3"/>
    </g>
    <g stroke="#fff" stroke-width="0.6" opacity="0.12">
      <path d="M10 20 L56 20"/><path d="M10 32 L40 32"/><path d="M58 42 L108 42"/><path d="M58 54 L82 54"/>
      <path d="M22 68 L72 68"/><path d="M22 80 L50 80"/>
    </g>
    <g fill="#fff" opacity="0.15">
      <polygon points="95,8 105,28 85,28"/>
    </g>
  </svg>`,
};
---

<SpotifyLayout title="Experiencia · Adolfo Alvarez" playerTitle="Experiencia">
  <article class="discography-page">
    <header class="page-header">
      <h1 class="page-title">Experiencia</h1>
      <p class="page-subtitle">Discografía profesional</p>
    </header>

    <div class="album-grid">
      {sorted.map((entry, i) => {
        const { data } = entry;
        const periodStr = data.period.end
          ? `${formatDate(data.period.start)} – ${formatDate(data.period.end)}`
          : `${formatDate(data.period.start)} – presente`;

        return (
          <article class="album-card" style={`--i: ${i}`} data-card={JSON.stringify({ id: entry.id, title: data.title, company: data.company, role: data.role, description: data.description ?? '', techStack: data.techStack, metrics: data.metrics, period: periodStr })}>
            <div class="album-art">
              <div class="album-art-svg" set:html={albumArt[entry.id] ?? albumArt.adc}></div>
              <button class="album-play" aria-label="Reproducir">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>

            <h2 class="album-title">{data.title}</h2>
            <p class="album-meta">
              <span class="album-company">{data.company}</span>
              <span class="album-sep">·</span>
              <span>{data.role}</span>
            </p>
            {data.description && <p class="album-desc">{data.description}</p>}

            <div class="album-tags">
              {data.techStack.slice(0, 5).map((tech) => (
                <span class="tag">{tech}</span>
              ))}
              {data.techStack.length > 5 && (
                <span class="tag tag-more">+{data.techStack.length - 5}</span>
              )}
            </div>

            <div class="album-tracks">
              {data.metrics.slice(0, 3).map((m, i) => (
                <div class="mini-track">
                  <span class="mini-track-num">{i + 1}</span>
                  <span class="mini-track-name">{m.label}</span>
                  <span class="mini-track-val">{m.value}</span>
                </div>
              ))}
            </div>

            <p class="album-period">{periodStr}</p>
          </article>
        );
      })}
    </div>

    <!-- Related — horizontal scroll row -->
    <section class="related-section">
      <div class="related-header">
        <h2 class="related-title">Fans también vieron</h2>
        <span class="related-show">Mostrar todo</span>
      </div>
      <div class="related-scroll">
        {[
          { name: 'Serverless', img: '⚡', desc: 'Arquitectura' },
          { name: 'Clean Architecture', img: '🧱', desc: 'Diseño de software' },
          { name: 'Event-Driven', img: '🔀', desc: 'Microservicios' },
          { name: 'DDD', img: '📐', desc: 'Domain-Driven Design' },
          { name: 'CI/CD', img: '🔄', desc: 'DevOps' },
          { name: 'TypeScript', img: '💎', desc: 'Lenguaje principal' },
        ].map((item) => (
          <article class="related-card">
            <div class="related-img">{item.img}</div>
            <h3 class="related-name">{item.name}</h3>
            <p class="related-desc">{item.desc}</p>
          </article>
        ))}
      </div>
    </section>
  </article>

  <!-- Card detail overlay -->
  <div class="album-overlay" id="album-overlay" aria-hidden="true">
    <div class="overlay-backdrop"></div>
      <div class="overlay-panel" style="backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">
      <button class="overlay-close" aria-label="Cerrar">&times;</button>
      <div class="overlay-art" id="overlay-art"></div>
      <h2 class="overlay-title" id="overlay-title"></h2>
      <p class="overlay-meta" id="overlay-meta"></p>
      <p class="overlay-desc" id="overlay-desc"></p>
      <div class="overlay-tags" id="overlay-tags"></div>
      <div class="overlay-metrics" id="overlay-metrics"></div>
      <p class="overlay-period" id="overlay-period"></p>
    </div>
  </div>
</SpotifyLayout>

<style>
  .discography-page {
    max-width: 1100px;
    padding: var(--space-3xl);
    margin: 0 auto;
  }

  .page-header {
    padding-top: var(--space-3xl);
    margin-bottom: var(--space-3xl);
    animation: pageIn 0.5s ease-out;
  }

  @keyframes pageIn {
    from { opacity: 0; transform: translateY(16px); }
  }

  .page-title {
    font: var(--text-display-lg);
    color: var(--spotify-text-primary);
    margin-bottom: var(--space-sm);
  }

  .page-subtitle {
    font: var(--text-body);
    color: var(--spotify-text-subdued);
  }

  /* ── Album grid ───────────────────────────────────────────────── */
  .album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-2xl);
    perspective: 1000px;
  }

  /* ── Album card ───────────────────────────────────────────────── */
  .album-card {
    background: rgba(255,255,255,0.03);
    border-radius: var(--card-radius);
    padding: var(--space-lg);
    transition: background 0.25s ease, transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    animation: cardIn 0.5s ease-out both;
    animation-delay: calc(var(--i, 0) * 0.08s);
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .album-card:hover {
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }

  .album-art {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: var(--space-md);
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease;
    background: var(--spotify-elevated);
  }

  .album-art-svg {
    position: absolute;
    inset: 0;
  }

  .album-art-svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .album-card:hover .album-art {
    transform: scale(1.02);
  }

  .album-play {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--spotify-green);
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(12px) scale(0.8);
    transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease;
    box-shadow: 0 8px 20px rgba(0,0,0,0.5);
  }

  .album-card:hover .album-play {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .album-play:hover {
    transform: translateY(0) scale(1.12) !important;
    background: var(--spotify-green-hover);
  }

  .album-play:active {
    transform: translateY(0) scale(0.94) !important;
  }

  .album-title {
    font: var(--text-heading);
    color: var(--spotify-text-primary);
    margin-bottom: var(--space-xs);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }

  .album-meta {
    font: var(--text-body-sm);
    color: var(--spotify-text-subdued);
    margin-bottom: var(--space-sm);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .album-company {
    color: var(--spotify-text-primary);
    font-weight: 600;
  }

  .album-sep { color: var(--spotify-text-subdued); }

  .album-desc {
    font: var(--text-body-sm);
    color: var(--spotify-text-secondary);
    margin-bottom: var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.5;
  }

  /* ── Tech tags ────────────────────────────────────────────────── */
  .album-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
  }

  .tag {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--spotify-highlight);
    font: var(--text-caption);
    color: var(--spotify-text-secondary);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .tag:hover {
    background: rgba(30,215,96,0.15);
    color: var(--spotify-green);
  }

  .tag-more {
    background: transparent;
    border: 1px solid var(--spotify-highlight);
  }

  /* ── Mini tracks (metrics) ────────────────────────────────────── */
  .album-tracks {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-md);
  }

  .mini-track {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    align-items: center;
    padding: 6px var(--space-sm);
    border-radius: var(--radius-sm);
    transition: background 0.15s ease;
  }

  .mini-track:hover { background: rgba(255,255,255,0.04); }

  .mini-track-num {
    font: var(--text-body-sm);
    color: var(--spotify-text-subdued);
    text-align: center;
    transition: color 0.15s ease;
  }

  .mini-track:hover .mini-track-num { color: var(--spotify-green); }

  .mini-track-name {
    font: var(--text-body-sm);
    color: var(--spotify-text-secondary);
    transition: color 0.15s ease;
  }

  .mini-track:hover .mini-track-name { color: var(--spotify-text-primary); }

  .mini-track-val {
    font: var(--text-body-sm);
    color: var(--spotify-text-primary);
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .album-period {
    font: var(--text-caption);
    color: var(--spotify-text-subdued);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .album-grid { grid-template-columns: 1fr; }
  }

  /* ── Related ──────────────────────────────────────────────────── */
  .related-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-3xl);
    border-top: 1px solid #282828;
    position: relative;
  }

  .related-section::before,
  .related-section::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }

  .related-section::before {
    left: 0;
    background: linear-gradient(to right, var(--spotify-base) 0%, transparent 100%);
  }

  .related-section::after {
    right: 0;
    background: linear-gradient(to left, var(--spotify-base) 0%, transparent 100%);
  }

  .related-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-xl);
  }

  .related-title {
    font: var(--text-display-sm);
    color: var(--spotify-text-primary);
  }

  .related-show {
    font: var(--text-body-sm);
    color: var(--spotify-text-subdued);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .related-show:hover { color: var(--spotify-text-primary); }

  .related-scroll {
    display: flex;
    gap: var(--space-xl);
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: var(--space-md);
    -webkit-overflow-scrolling: touch;
  }

  .related-scroll::-webkit-scrollbar { display: none; }

  .related-card {
    flex: 0 0 160px;
    background: rgba(255,255,255,0.03);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.25s ease, box-shadow 0.25s ease;
    text-align: center;
  }

  .related-card:hover {
    background: rgba(255,255,255,0.06);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .related-img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #1a2a1a, #1a1f1a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    margin-bottom: var(--space-md);
    transition: transform 0.3s ease;
  }

  .related-card:hover .related-img { transform: scale(1.05); }

  .related-name {
    font: var(--text-body-sm);
    font-weight: 600;
    color: var(--spotify-text-primary);
    margin-bottom: 2px;
    transition: color 0.15s ease;
  }

  .related-card:hover .related-name { color: var(--spotify-green); }

  .related-desc {
    font: var(--text-caption);
    color: var(--spotify-text-subdued);
  }

  /* ── Overlay ──────────────────────────────────────────────────── */
  :global(.album-overlay) {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
