<script>
  let escHandler: ((e: KeyboardEvent) => void) | null = null;

  function openOverlay(card: HTMLElement) {
    const data = JSON.parse(card.dataset.card || '{}');
    const overlay = document.getElementById('album-overlay')!;
    const artSvg = card.querySelector('.album-art-svg')?.innerHTML ?? '';

    document.getElementById('overlay-art')!.innerHTML = artSvg;
    document.getElementById('overlay-title')!.textContent = data.title;
    document.getElementById('overlay-meta')!.textContent = `${data.company} · ${data.role}`;
    document.getElementById('overlay-desc')!.textContent = data.description;
    document.getElementById('overlay-period')!.textContent = data.period;

    const tagsEl = document.getElementById('overlay-tags')!;
    tagsEl.innerHTML = data.techStack.map((t: string) => `<span class="tag">${t}</span>`).join('');

    const metricsEl = document.getElementById('overlay-metrics')!;
    metricsEl.innerHTML = data.metrics.map((m: { label: string; value: string }) =>
      `<div class="overlay-metric-item"><span class="overlay-metric-val">${m.value}</span><span class="overlay-metric-label">${m.label}</span></div>`
    ).join('');

    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
  }

  function closeOverlay() {
    const overlay = document.getElementById('album-overlay');
    if (overlay) {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
    }
  }

  function init() {
    // Card click handlers
    document.querySelectorAll<HTMLElement>('.album-card').forEach((card) => {
      if (card.dataset.bound) return;
      card.dataset.bound = '1';
      card.style.cursor = 'pointer';
      card.addEventListener('click', () => openOverlay(card));
    });

    // Overlay close: backdrop click
    const overlay = document.getElementById('album-overlay');
    if (overlay && !overlay.dataset.ready) {
      overlay.dataset.ready = '1';
      overlay.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('overlay-backdrop')) closeOverlay();
      });
    }

    // Overlay close: close button
    const closeBtn = document.querySelector('.overlay-close');
    if (closeBtn && !closeBtn.dataset.ready) {
      closeBtn.dataset.ready = '1';
      closeBtn.addEventListener('click', closeOverlay);
    }

    // Escape key (only one global listener)
    if (!escHandler) {
      escHandler = (e: KeyboardEvent) => { if (e.key === 'Escape') closeOverlay(); };
      document.addEventListener('keydown', escHandler);
    }
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
