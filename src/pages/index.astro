---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/immersive/Header.astro';
import Scene from '../components/immersive/Scene.astro';
import CvGame from '../components/immersive/CvGame';
import { site } from '../data/site';
import { cv } from '../data/portfolio';
---

<BaseLayout title={`${site.name} · Senior Backend Engineer`}>
  <div id="top" class="imm">
    <Header />
    <Scene />
    <section id="contacto" class="contact">
      <div class="imm-eyebrow">Contacto</div>
      <h2>Hablemos</h2>
      <p>{site.email} · {site.phone}</p>
      <CvGame client:visible cv={cv} />
    </section>
  </div>
</BaseLayout>

<style>
  .contact { padding: 72px 32px 110px; max-width: 760px; margin: 0 auto; }
  h2 { margin: 12px 0; font-size: 44px; letter-spacing: -0.02em; }
  p { margin: 0; color: var(--muted); line-height: 1.6; max-width: 52ch; }
</style>
