---
import SpotifyLayout from '../layouts/SpotifyLayout.astro';
---

<SpotifyLayout title="Adolfo Alvarez · Backend Engineer" playerTitle="Perfil">
  <article class="artist-page">
    <header class="artist-header">
      <div class="artist-avatar">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="avatar-svg">
          <defs><linearGradient id="av-grad" x1="0" y1="0" x2="200" y2="200"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
          <rect width="200" height="200" fill="url(#av-grad)"/>
          <g fill="#fff" opacity="0.12">
            <circle cx="100" cy="55" r="48"/>
            <circle cx="100" cy="175" r="65"/>
          </g>
          <g stroke="#fff" stroke-width="0.6" opacity="0.15">
            <line x1="100" y1="103" x2="100" y2="175"/>
            <line x1="65" y1="130" x2="135" y2="130"/>
          </g>
          <g fill="none" stroke="#fff" stroke-width="0.5" opacity="0.1">
            <circle cx="100" cy="100" r="90"/><circle cx="100" cy="100" r="70"/><circle cx="100" cy="100" r="50"/>
          </g>
          <g fill="#fff" opacity="0.2">
            <circle cx="60" cy="45" r="2"/><circle cx="140" cy="45" r="2"/>
            <circle cx="100" cy="25" r="2.5"/><circle cx="75" cy="65" r="1.5"/><circle cx="125" cy="65" r="1.5"/>
          </g>
        </svg>
      </div>
      <div class="artist-meta">
        <p class="artist-verified">✅ Ingeniero verificado</p>
        <h1 class="artist-name">Adolfo Esteban Alvarez Pacheco</h1>
        <p class="artist-listeners">6+ años de experiencia · Mérida, Yucatán, México</p>
      </div>
    </header>

    <div class="artist-actions">
      <button class="btn-play" id="hero-play" aria-label="Reproducir">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button class="btn-follow" id="btn-follow">Seguir</button>
      <button class="btn-more" aria-label="Más opciones">···</button>
    </div>

    <section class="section">
      <h2 class="section-title">Popular</h2>
      <div class="track-list">
        {[
          { num: 1, name: 'Node.js & TypeScript', plays: 'Stack principal' },
          { num: 2, name: 'AWS Serverless', plays: 'Lambda, API GW, DynamoDB, SQS' },
          { num: 3, name: 'NestJS & Express', plays: 'Frameworks backend' },
          { num: 4, name: 'Domain-Driven Design', plays: 'Arquitectura de software' },
          { num: 5, name: 'PostgreSQL & Redis', plays: 'Bases de datos' },
        ].map((track, i) => (
          <div class="track-row" style={`--delay: ${i * 60}ms`}>
            <span class="track-num">
              <span class="track-num-text">{track.num}</span>
              <span class="track-play-icon">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <span class="track-eq">
                <span class="eq-bar"></span><span class="eq-bar"></span><span class="eq-bar"></span>
              </span>
            </span>
            <div class="track-info">
              <span class="track-name">{track.name}</span>
              <span class="track-plays">{track.plays}</span>
            </div>
            <span class="track-time">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a6.5 6.5 0 100 13 6.5 6.5 0 000-13zM0 8a8 8 0 1116 0A8 8 0 010 8z"/><path d="M8 3.25a.75.75 0 01.75.75v3.69l2.28 2.28a.75.75 0 11-1.06 1.06l-2.5-2.5A.75.75 0 017.25 8V4A.75.75 0 018 3.25z"/></svg>
            </span>
          </div>
        ))}
      </div>
    </section>

    <div class="artist-cta">
      <a href="/experiencia" class="btn-primary">Ver experiencia completa</a>
      <a href="/contact" class="btn-outline">Contacto</a>
    </div>
  </article>
</SpotifyLayout>

<style>
  .artist-page {
    max-width: 900px;
    padding: var(--space-3xl);
    margin: 0 auto;
    animation: pageIn 0.6s ease-out;
  }

  @keyframes pageIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .artist-header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    padding-top: var(--space-5xl);
  }

  .artist-avatar {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    flex-shrink: 0;
    transition: transform 0.5s ease, box-shadow 0.5s ease;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(30, 215, 96, 0.2), 0 0 60px rgba(30, 215, 96, 0.05), 0 0 0 8px rgba(30, 215, 96, 0.06);
  }

  .avatar-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .artist-avatar::after {
    content: '';
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(30,215,96,0.15) 0%, transparent 70%);
    z-index: -1;
    transition: opacity 0.5s ease;
    opacity: 0.6;
  }

  .artist-avatar:hover::after {
    opacity: 1;
  }

  .artist-avatar:hover {
    transform: scale(1.03);
    box-shadow: 0 12px 40px rgba(30, 215, 96, 0.3), 0 0 80px rgba(30, 215, 96, 0.1), 0 0 0 12px rgba(30, 215, 96, 0.08);
  }

  .artist-meta { display: flex; flex-direction: column; gap: var(--space-sm); padding-bottom: var(--space-xs); }

  .artist-verified {
    font: var(--text-body-sm);
    color: var(--spotify-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .artist-name {
    font: var(--text-display-xl);
    color: var(--spotify-text-primary);
    letter-spacing: -1.5px;
  }

  .artist-listeners {
    font: var(--text-body);
    color: var(--spotify-text-secondary);
  }

  /* ── Actions ──────────────────────────────────────────────────── */
  .artist-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }

  .btn-play {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--spotify-green);
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 16px rgba(30, 215, 96, 0.3);
  }

  .btn-play:hover {
    transform: scale(1.08);
    background: var(--spotify-green-hover);
    box-shadow: 0 6px 24px rgba(30, 215, 96, 0.4);
  }

  .btn-play:active {
    transform: scale(0.96);
  }

  .btn-play.playing {
    animation: playPulse 2s ease-in-out infinite;
  }

  @keyframes playPulse {
    0%, 100% { box-shadow: 0 4px 16px rgba(30, 215, 96, 0.3); }
    50% { box-shadow: 0 4px 28px rgba(30, 215, 96, 0.5); }
  }

  .btn-follow {
    padding: var(--space-xs) var(--space-2xl);
    border: 1px solid var(--spotify-text-subdued);
    border-radius: var(--radius-pill);
    color: var(--spotify-text-primary);
    font: var(--text-button);
    background: transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .btn-follow:hover { border-color: var(--spotify-text-primary); }
  .btn-follow.following {
    border-color: var(--spotify-green);
    color: var(--spotify-green);
  }

  .btn-more {
    font: var(--text-display-md);
    color: var(--spotify-text-subdued);
    letter-spacing: 2px;
    transition: color 0.2s ease;
  }

  .btn-more:hover { color: var(--spotify-text-primary); }

  /* ── Sections ─────────────────────────────────────────────────── */
  .section { margin-bottom: var(--space-4xl); }

  .section-title {
    font: var(--text-display-sm);
    color: var(--spotify-text-primary);
    margin-bottom: var(--space-xl);
  }

  /* ── Track list ───────────────────────────────────────────────── */
  .track-list { display: flex; flex-direction: column; }

  .track-row {
    display: grid;
    grid-template-columns: 48px 1fr 40px;
    align-items: center;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-sm);
    transition: background 0.2s ease;
    cursor: default;
    position: relative;
  }

  .track-row:hover {
    background: rgba(255,255,255,0.06);
  }

  .track-row:hover .track-name { color: var(--spotify-green); }

  .track-num {
    width: 48px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .track-num-text {
    font: var(--text-body);
    color: var(--spotify-text-subdued);
    transition: opacity 0.15s ease;
  }

  .track-row:hover .track-num-text { opacity: 0; }

  .track-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--spotify-green);
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .track-row:hover .track-play-icon {
    opacity: 1;
    transform: scale(1);
  }

  /* ── Equalizer bars (like Spotify's now-playing) ──────────────── */
  .track-eq {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 2px;
    padding-bottom: 10px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .track-row:hover .track-eq { opacity: 1; }
  .track-row:hover .track-play-icon { display: none; }
  .track-row:hover .track-eq .eq-bar { animation-play-state: running; }

  .eq-bar {
    width: 3px;
    background: var(--spotify-green);
    border-radius: 2px;
    animation: eqBounce 0.8s ease-in-out infinite;
    animation-play-state: paused;
  }

  .eq-bar:nth-child(1) { height: 10px; animation-delay: 0s; }
  .eq-bar:nth-child(2) { height: 16px; animation-delay: 0.15s; }
  .eq-bar:nth-child(3) { height: 8px; animation-delay: 0.05s; }

  @keyframes eqBounce {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.4); }
  }

  .track-info { display: flex; flex-direction: column; gap: 2px; }

  .track-name {
    font: var(--text-body);
    color: var(--spotify-text-primary);
    transition: color 0.15s ease;
  }

  .track-plays {
    font: var(--text-body-sm);
    color: var(--spotify-text-subdued);
  }

  .track-time {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    color: var(--spotify-text-subdued);
    transition: color 0.15s ease;
  }

  .track-row:hover .track-time { color: var(--spotify-green); }

  /* ── CTA ──────────────────────────────────────────────────────── */
  .artist-cta {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--button-primary-bg);
    color: var(--button-primary-text);
    font: var(--text-button);
    padding: var(--button-primary-padding);
    border-radius: var(--button-primary-rounded);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .btn-primary:hover { transform: scale(1.04); opacity: 0.9; }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--spotify-text-primary);
    font: var(--text-button);
    padding: var(--space-xs) var(--space-2xl);
    border-radius: var(--radius-pill);
    border: 1px solid var(--spotify-text-subdued);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .btn-outline:hover { border-color: var(--spotify-text-primary); }

  @media (max-width: 768px) {
    .artist-header { flex-direction: column; align-items: center; text-align: center; padding-top: var(--space-3xl); }
    .artist-avatar { width: 140px; height: 140px; }
    .artist-name { font-size: 40px; line-height: 44px; }
    .artist-actions { justify-content: center; }
  }
</style>

<script>
  function initHome() {
    const playBtn = document.getElementById('hero-play');
    const followBtn = document.getElementById('btn-follow');
    let playing = false;

    if (playBtn && !playBtn.dataset.ready) {
      playBtn.dataset.ready = '1';
      playBtn.addEventListener('click', () => {
        playing = !playing;
        playBtn.classList.toggle('playing', playing);
        playBtn.innerHTML = playing
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>'
          : '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
      });
    }

    if (followBtn && !followBtn.dataset.ready) {
      followBtn.dataset.ready = '1';
      followBtn.addEventListener('click', () => {
        const following = followBtn.classList.toggle('following');
        followBtn.textContent = following ? 'Siguiendo' : 'Seguir';
      });
    }
  }

  document.addEventListener('astro:page-load', initHome);
  initHome();
</script>
