---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Starfield from '../components/animations/Starfield.astro';
import Constellation from '../components/sections/Constellation.astro';
import SectionHeader from '../components/sections/SectionHeader.astro';
import Comet from '../components/sections/Comet.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import ExperienceStack from '../components/sections/ExperienceStack';
import SplitText from '../components/animations/SplitText';
import { MorphingText } from '../components/animations/MorphingText';
import SocialAvatars from '../components/animations/social-avatars';
import MagicBento from '../components/animations/MagicBento';
import { getCollection } from 'astro:content';
import { buttonVariants } from '@/components/animations/button-styled';
import { Badge } from '@/components/ui/badge';
import { site } from '../data/site';
import { languages } from '../data/skills';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.published !== false)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    const orderA = a.data.order ?? Number.MAX_SAFE_INTEGER;
    const orderB = b.data.order ?? Number.MAX_SAFE_INTEGER;
    if (orderA !== orderB) return orderA - orderB;
    return b.data.period.start.getTime() - a.data.period.start.getTime();
  });

function formatPeriod(p: { start: Date; end?: Date }) {
  const start = p.start.getUTCFullYear();
  if (!p.end) return `${start} — Actualidad`;
  const end = p.end.getUTCFullYear();
  return start === end ? `${start}` : `${start} — ${end}`;
}

const especialidades = [
  'arquitecturas backend escalables',
  'REST / GraphQL / WebSockets',
  'microservicios',
  'Clean Architecture',
  'DDD',
  'SOLID',
  'serverless',
  'IaC (AWS CDK)',
  'optimización de rendimiento',
  'mentoría técnica',
  'code reviews',
  'AI-assisted development',
];
---

<BaseLayout title={`${site.name} · ${site.role}`}>
  <Starfield />
  <Nav />

  <main class="mx-auto max-w-5xl px-5">
    <section id="hero" class="relative flex min-h-screen flex-col justify-center py-24">
      <Constellation />

      <div class="space-y-6">
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
          <span class="text-muted-foreground/70">{site.location}</span>
          <span class="mx-2" aria-hidden="true">·</span>
          <MorphingText
            client:load
            text={['Senior Software Engineer', 'Backend', 'Cloud', 'System Design']}
            loop
          />
        </p>

        <SplitText
          client:load
          tag="h1"
          text={site.name}
          splitType="words"
          textAlign="left"
          delay={140}
          className="max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight text-foreground sm:text-6xl"
        />

        <p class="font-mono text-sm uppercase tracking-[0.2em] text-primary">
          {site.role}
        </p>

        <p class="max-w-xl text-lg text-muted-foreground">
          {site.tagline}. Diseño soluciones escalables antes de escribir código,
          con arquitecturas simples y mantenibles.
        </p>

        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#proyectos" class={buttonVariants()}>Ver proyectos</a>
          <a href="#contacto" class={buttonVariants({ variant: 'outline' })}>Contacto</a>
        </div>

        <div class="pt-10">
          <SocialAvatars client:load />
        </div>
      </div>
    </section>

    <section id="sobre-mi" class="relative scroll-mt-16 py-24">
      <Comet />
      <SectionHeader
        eyebrow="Sobre mí"
        title="Quién soy"
        description="Perfil, especialidades y forma de trabajar."
      />

      <div class="mt-10 grid gap-8 md:grid-cols-[1.35fr_1fr]" data-reveal>
        <div class="space-y-6">
          <p class="text-base leading-relaxed text-muted-foreground">
            Senior Software Engineer con más de 6 años en backend con Node.js,
            TypeScript y AWS. He trabajado en telecomunicaciones, hotelería,
            RRHH, logística y servicios públicos, llevando productos de cero a
            producción.
          </p>

          <div class="grid gap-3 sm:grid-cols-3">
            <div class="group rounded-xl border border-border/60 bg-card/40 p-4 transition-colors duration-300 hover:border-primary/40">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="size-5 text-primary transition-all duration-300 group-hover:scale-110 group-hover:drop-shadow-[0_0_6px_rgba(122,143,194,0.7)]" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="4.5" />
                <circle cx="12" cy="12" r="0.5" />
              </svg>
              <p class="mt-3 text-sm font-medium text-foreground">El negocio primero</p>
              <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Entender el problema antes de implementar.</p>
            </div>

            <div class="group rounded-xl border border-border/60 bg-card/40 p-4 transition-colors duration-300 hover:border-primary/40">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-primary transition-all duration-300 group-hover:scale-110 group-hover:drop-shadow-[0_0_6px_rgba(122,143,194,0.7)]" aria-hidden="true">
                <path d="M12 3 3 8l9 5 9-5-9-5Z" />
                <path d="M3 12l9 5 9-5" />
                <path d="M3 16l9 5 9-5" />
              </svg>
              <p class="mt-3 text-sm font-medium text-foreground">Arquitectura honesta</p>
              <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Simple, escalable y mantenible.</p>
            </div>

            <div class="group rounded-xl border border-border/60 bg-card/40 p-4 transition-colors duration-300 hover:border-primary/40">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-primary transition-all duration-300 group-hover:scale-110 group-hover:drop-shadow-[0_0_6px_rgba(122,143,194,0.7)]" aria-hidden="true">
                <path d="M12 3v3" />
                <path d="M12 18v3" />
                <path d="M3 12h3" />
                <path d="M18 12h3" />
                <path d="m5.6 5.6 2.1 2.1" />
                <path d="m16.3 16.3 2.1 2.1" />
                <path d="m5.6 18.4 2.1-2.1" />
                <path d="m16.3 7.7 2.1-2.1" />
              </svg>
              <p class="mt-3 text-sm font-medium text-foreground">IA con criterio</p>
              <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Una herramienta, no un sustituto del juicio.</p>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-border/60 bg-card/40">
          <dl class="divide-y divide-border/60 text-sm">
            <div class="flex items-baseline justify-between gap-4 px-5 py-2.5">
              <dt class="text-muted-foreground">Ubicación</dt>
              <dd class="text-right text-foreground">{site.location}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 px-5 py-2.5">
              <dt class="text-muted-foreground">Experiencia</dt>
              <dd class="text-right text-foreground">6+ años</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 px-5 py-2.5">
              <dt class="text-muted-foreground">Enfoque</dt>
              <dd class="text-right text-foreground">Backend · Cloud · AI-assisted</dd>
            </div>
            <div class="px-5 py-2.5">
              <dt class="text-muted-foreground">Educación</dt>
              <dd class="mt-1.5 space-y-1.5">
                <div class="text-foreground">
                  Instituto Tecnológico de Mérida
                  <span class="block text-xs text-muted-foreground">Ing. Sistemas Computacionales · 2017–2021</span>
                </div>
                <div class="text-foreground">
                  Conalep Mérida I
                  <span class="block text-xs text-muted-foreground">Prof. Técnico Bachiller en Informática · 2014–2017</span>
                </div>
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 px-5 py-2.5">
              <dt class="text-muted-foreground">Idiomas</dt>
              <dd class="text-right text-foreground">Español nativo · Inglés intermedio</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="mt-8" data-reveal data-reveal-delay="80">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">Especialidades</p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {especialidades.map((e) => (
            <Badge variant="outline">{e}</Badge>
          ))}
        </div>
      </div>

      <div class="mt-8" data-reveal data-reveal-delay="120">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">Lenguajes</p>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          {languages.map((l, i) => (
            <Fragment>
              {i > 0 && <span class="text-border" aria-hidden="true"> · </span>}
              {l.learning ? (
                <span class="text-[color:var(--redshift)]">{l.name} <span class="text-[color:var(--redshift)]/60">(aprendizaje)</span></span>
              ) : (
                <span class="text-foreground/80">{l.name}</span>
              )}
            </Fragment>
          ))}
        </p>
      </div>
    </section>

    <section id="experiencia" class="scroll-mt-16 py-24">
      <SectionHeader
        eyebrow="Experiencia"
        title="Trayectoria"
        description="Carrera profesional, roles y responsabilidades."
      />

      <div class="mt-12">
        <ExperienceStack
          client:load
          projects={projects.map((p) => ({
            role: p.data.role,
            company: p.data.company,
            period: formatPeriod(p.data.period),
            description: p.data.description,
            techStack: p.data.techStack,
          }))}
        />
      </div>
    </section>

    <SkillsSection />

    <section id="proyectos" class="scroll-mt-16 py-24">
      <SectionHeader
        eyebrow="Proyectos"
        title="Casos de estudio"
        description="Proyectos destacados con métricas e impacto."
      />

      <div class="mt-10" data-reveal>
        <MagicBento
          client:load
          items={projects.map((p) => ({
            title: p.data.title,
            company: p.data.company,
            role: p.data.role,
            period: formatPeriod(p.data.period),
            description: p.data.description,
            techStack: p.data.techStack,
            metrics: p.data.metrics,
            featured: p.data.featured,
          }))}
        />
      </div>
    </section>

    <section id="contacto" class="scroll-mt-16 py-24">
      <SectionHeader
        eyebrow="Contacto"
        title="Hablemos"
        description="Disponible para colaborar. Respondo en menos de 24 horas."
      />

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        <a href={site.social.github} target="_blank" rel="noopener noreferrer"
          class="group flex flex-col gap-3 rounded-xl border border-border/60 bg-card/40 p-5 transition-colors duration-300 hover:border-foreground/40">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">GitHub</span>
          <span class="text-sm text-foreground">@Alvarez-P</span>
          <span class="text-sm text-muted-foreground transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>

        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer"
          class="group flex flex-col gap-3 rounded-xl border border-border/60 bg-card/40 p-5 transition-colors duration-300 hover:border-foreground/40">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">LinkedIn</span>
          <span class="text-sm text-foreground">Adolfo Esteban Alvarez Pacheco</span>
          <span class="text-sm text-muted-foreground transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>

        <a href={`mailto:${site.email}`}
          class="group flex flex-col gap-3 rounded-xl border border-border/60 bg-card/40 p-5 transition-colors duration-300 hover:border-foreground/40">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">Email</span>
          <span class="break-all text-sm text-foreground">{site.email}</span>
          <span class="text-sm text-muted-foreground transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>

        <a href={`tel:${site.phone.replace(/\s/g, '')}`}
          class="group flex flex-col gap-3 rounded-xl border border-border/60 bg-card/40 p-5 transition-colors duration-300 hover:border-foreground/40">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground">Teléfono</span>
          <span class="text-sm text-foreground">{site.phone}</span>
          <span class="text-sm text-muted-foreground transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
      </div>

      <div class="mt-8 rounded-xl border border-border/60 bg-card/40 p-5" data-reveal data-reveal-delay="80">
        <div class="flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-foreground" aria-hidden="true"></span>
            <span class="text-foreground">Disponible</span>
          </div>
          <span class="text-muted-foreground">Remoto · {site.location}</span>
          <span class="text-muted-foreground">GMT-6 (América)</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-border/60">
    <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-muted-foreground sm:flex-row">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p class="font-mono text-xs">Astro · shadcn/ui · tema espacial</p>
    </div>
  </footer>
</BaseLayout>
