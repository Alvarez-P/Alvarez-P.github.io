---
/**
 * /projects — Case study listing page.
 *
 * Renders a list of project cards sorted chronologically (newest first).
 * Structure:
 *   - Eyebrow: "PORTAFOLIO"
 *   - Title: "Proyectos"
 *   - Subtitle: body-lg paragraph
 *   - Green divider band
 *   - Project cards (1-up stacked list)
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Sort: by period.start descending (newest first), then by order if present
const sorted = projects
  .filter((p) => p.data.published)
  .sort((a, b) => {
    // If both have order, use it
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    // If only one has order, ordered comes first
    if (a.data.order !== undefined) return -1;
    if (b.data.order !== undefined) return 1;
    // Otherwise sort by start date descending
    return b.data.period.start.getTime() - a.data.period.start.getTime();
  });
---}

<BaseLayout title="proyectos · backend engineer · portfolio">
  <section class="projects-page">
    <!-- Hero section -->
    <header class="projects-hero">
      <p class="projects-eyebrow">PORTAFOLIO</p>
      <h1 class="projects-title">Proyectos</h1>
      <p class="projects-subtitle">
        Una colección de casos de estudio que documentan decisiones de arquitectura,
        patrones de diseño, y resultados medibles. Cada proyecto representa un
        desafío real resuelto con ingeniería pragmática.
      </p>
    </header>

    <!-- Green divider band -->
    <div class="green-divider" aria-hidden="true"></div>

    <!-- Project list -->
    <div class="projects-list">
      {sorted.map((entry) => (
        <ProjectCard entry={entry} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* ========================================================================
     Projects page
     ======================================================================== */
  .projects-page {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-5xl) var(--space-3xl) var(--space-5xl);
  }

  /* ========================================================================
     Hero section
     ======================================================================== */
  .projects-hero {
    margin-bottom: var(--space-4xl);
    margin-block-end: var(--space-4xl);
  }

  .projects-eyebrow {
    font: var(--text-eyebrow);
    letter-spacing: var(--text-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: var(--space-sm);
    margin-block-end: var(--space-sm);
  }

  .projects-title {
    font: var(--text-display-lg);
    letter-spacing: var(--text-display-lg-tracking);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
    margin-block-end: var(--space-md);
  }

  .projects-subtitle {
    font: var(--text-body-lg);
    color: var(--color-body);
    max-width: 65ch;
  }

  /* ========================================================================
     Green divider band — 2px solid primary
     ======================================================================== */
  .green-divider {
    height: 2px;
    background: var(--color-primary);
    border: none;
    margin-bottom: var(--space-4xl);
    margin-block-end: var(--space-4xl);
  }

  /* ========================================================================
     Project list — 1-up stacked cards
     ======================================================================== */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* ========================================================================
     Responsive
     ======================================================================== */
  @media (max-width: 768px) {
    .projects-page {
      padding: var(--space-3xl) var(--space-lg) var(--space-4xl);
    }

    .projects-title {
      font-size: 28px;
      line-height: 34px;
    }
  }
</style>
