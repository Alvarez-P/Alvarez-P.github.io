---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="contacto · backend engineer · portfolio">
  <article class="contact-page">
    <header class="contact-header">
      <h1 class="contact-title">
        <span class="prompt">$</span> cat <span class="arg">~/contact.md</span>
      </h1>
      <p class="contact-subtitle">
        Prefiero mensajes directos y concretos. Cuéntame el contexto, no solo el "hola".
      </p>
    </header>

    <section class="contact-links">
      <a href="https://github.com/gentleman-programming" class="contact-card" rel="noopener noreferrer">
        <span class="contact-card-icon" aria-hidden="true">&gt;_</span>
        <div class="contact-card-body">
          <span class="contact-card-label">GitHub</span>
          <span class="contact-card-value">@gentleman-programming</span>
        </div>
        <span class="contact-card-arrow" aria-hidden="true">→</span>
      </a>

      <a href="https://linkedin.com/in/gentleman-programming" class="contact-card" rel="noopener noreferrer">
        <span class="contact-card-icon" aria-hidden="true">[in]</span>
        <div class="contact-card-body">
          <span class="contact-card-label">LinkedIn</span>
          <span class="contact-card-value">/in/gentleman-programming</span>
        </div>
        <span class="contact-card-arrow" aria-hidden="true">→</span>
      </a>

      <a href="mailto:hello@gentlemanprogramming.com" class="contact-card">
        <span class="contact-card-icon" aria-hidden="true">@</span>
        <div class="contact-card-body">
          <span class="contact-card-label">Email</span>
          <span class="contact-card-value">hello@gentlemanprogramming.com</span>
        </div>
        <span class="contact-card-arrow" aria-hidden="true">→</span>
      </a>
    </section>

    <section class="contact-note">
      <div class="note-terminal">
        <span class="note-prompt">$</span>
        <span class="note-text">./disponibilidad</span>
      </div>
      <pre class="note-output">&#123;
  "status":     "disponible",
  "modalidad":  "remoto · latam · españa",
  "horario":    "zona horaria: América (GMT-6)",
  "prefieres":  "email &#62; LinkedIn &#62; GitHub Issues",
  "respuesta":  "&#60; 24h"
&#125;</pre>
    </section>
  </article>
</BaseLayout>

<style>
  .contact-page {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--content-padding) var(--space-xl);
  }

  .contact-header {
    margin-bottom: var(--space-xl);
  }

  .contact-title {
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-primary);
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .contact-title .prompt {
    color: var(--color-text-accent);
  }

  .contact-title .arg {
    color: var(--color-terminal-cyan);
  }

  .contact-subtitle {
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    padding-left: calc(1.5ch + var(--space-sm));
  }

  /* Contact Cards */
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .contact-card:hover {
    border-color: var(--color-border-accent);
    background-color: var(--color-bg-tertiary);
  }

  .contact-card:hover .contact-card-arrow {
    transform: translateX(4px);
  }

  .contact-card-icon {
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-lg);
    color: var(--color-text-accent);
    width: 40px;
    text-align: center;
    flex-shrink: 0;
  }

  .contact-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-card-label {
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-card-value {
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
  }

  .contact-card-arrow {
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    transition: transform var(--transition-fast);
  }

  .contact-card:hover .contact-card-arrow {
    color: var(--color-text-accent);
  }

  /* Availability Note */
  .contact-note {
    margin-top: var(--space-lg);
  }

  .note-terminal {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-sm);
  }

  .note-prompt {
    color: var(--color-text-accent);
  }

  .note-text {
    color: var(--color-text-primary);
  }

  .note-output {
    margin: 0;
    padding: var(--space-md);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-primary);
    overflow-x: auto;
  }

  @media (max-width: 640px) {
    .contact-card {
      flex-wrap: wrap;
    }

    .note-output {
      font-size: var(--font-size-xs);
    }
  }
</style>
