---
import SpotifyLayout from '../layouts/SpotifyLayout.astro';
---

<SpotifyLayout title="Contacto · Adolfo Alvarez" playerTitle="Contacto">
  <article class="contact-page">
    <header class="contact-header">
      <h1 class="contact-title">Contacto</h1>
      <p class="contact-subtitle">Disponible para colaborar. Respondo en menos de 24h.</p>
    </header>

    <div class="contact-cards">
      <a href="https://github.com/Alvarez-P" class="contact-card" rel="noopener noreferrer">
        <div class="cc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
        </div>
        <div class="cc-body">
          <span class="cc-label">GitHub</span>
          <span class="cc-value">@Alvarez-P</span>
        </div>
        <span class="cc-arrow">→</span>
      </a>

      <a href="https://www.linkedin.com/in/adolfo-esteban-%C3%A1lvarez-pacheco-6b3a21192/" class="contact-card" rel="noopener noreferrer">
        <div class="cc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="16" rx="2"/><circle cx="8" cy="11" r="2"/><path d="M8 15v3"/><path d="M12 11v7"/><path d="M16 9v9"/></svg>
        </div>
        <div class="cc-body">
          <span class="cc-label">LinkedIn</span>
          <span class="cc-value">Adolfo Esteban Alvarez Pacheco</span>
        </div>
        <span class="cc-arrow">→</span>
      </a>

      <a href="mailto:alvarez.p.esteban@gmail.com" class="contact-card">
        <div class="cc-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4l-10 8L2 4"/></svg>
        </div>
        <div class="cc-body">
          <span class="cc-label">Email</span>
          <span class="cc-value">alvarez.p.esteban@gmail.com</span>
        </div>
        <span class="cc-arrow">→</span>
      </a>
    </div>

    <section class="availability">
      <h2 class="avail-title">Disponibilidad</h2>
      <div class="avail-card">
        <div class="avail-row">
          <span class="avail-key">Estado</span>
          <span class="avail-val avail-live"><span class="live-dot"></span>Disponible</span>
        </div>
        <div class="avail-row">
          <span class="avail-key">Modalidad</span>
          <span class="avail-val">Remoto · Mérida, Yucatán, México</span>
        </div>
        <div class="avail-row">
          <span class="avail-key">Zona horaria</span>
          <span class="avail-val">GMT-6 (América)</span>
        </div>
      </div>
    </section>
  </article>
</SpotifyLayout>

<style>
  .contact-page {
    max-width: 600px;
    padding: var(--space-3xl);
    margin: 0 auto;
    animation: pageIn 0.5s ease-out;
  }

  @keyframes pageIn {
    from { opacity: 0; transform: translateY(16px); }
  }

  .contact-header {
    padding-top: var(--space-4xl);
    margin-bottom: var(--space-3xl);
  }

  .contact-title {
    font: var(--text-display-lg);
    color: var(--spotify-text-primary);
    margin-bottom: var(--space-sm);
  }

  .contact-subtitle {
    font: var(--text-body);
    color: var(--spotify-text-subdued);
  }

  /* ── Contact cards ────────────────────────────────────────────── */
  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-4xl);
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background: rgba(255,255,255,0.03);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-card:hover {
    background: rgba(255,255,255,0.06);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .cc-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--spotify-text-subdued);
    transition: color 0.2s ease;
  }

  .contact-card:hover .cc-icon { color: var(--spotify-green); }

  .cc-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cc-label {
    font: var(--text-caption);
    color: var(--spotify-text-subdued);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .cc-value {
    font: var(--text-body);
    color: var(--spotify-text-primary);
  }

  .cc-arrow {
    font: var(--text-body);
    color: var(--spotify-text-subdued);
    transition: transform var(--transition-fast);
  }

  .contact-card:hover .cc-arrow {
    transform: translateX(4px);
    color: var(--spotify-green);
  }

  /* ── Availability ─────────────────────────────────────────────── */
  .avail-title {
    font: var(--text-heading);
    color: var(--spotify-text-primary);
    margin-bottom: var(--space-lg);
  }

  .avail-card {
    background: rgba(255,255,255,0.03);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .avail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .avail-key {
    font: var(--text-body-sm);
    color: var(--spotify-text-subdued);
  }

  .avail-val {
    font: var(--text-body-sm);
    color: var(--spotify-text-primary);
  }

  .avail-live {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--spotify-green);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--spotify-green);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
