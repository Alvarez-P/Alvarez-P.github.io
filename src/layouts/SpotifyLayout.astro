---
import { ClientRouter } from 'astro:transitions';

import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import '../styles/tokens.css';
import '../styles/global.css';

import Sidebar from '../components/Sidebar.astro';
import PlayerBar from '../components/PlayerBar.astro';

export interface Props {
  title?: string;
  description?: string;
  playerTitle?: string;
}

const {
  title = 'backend engineer · portfolio',
  description = 'Backend engineer specializing in distributed systems, clean architecture, and serverless.',
  playerTitle,
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <div class="app-layout">
      <Sidebar />
      <main class="main-content" transition:animate="slide">
        <slot />
      </main>
    </div>
    <PlayerBar title={playerTitle ?? title} subtitle="Adolfo Esteban Alvarez Pacheco" />
  </body>
</html>

<style>
  .app-layout {
    display: flex;
    min-height: calc(100vh - var(--player-height));
    background: var(--spotify-base);
  }

  .main-content {
    flex: 1;
    margin-left: var(--sidebar-width);
    padding-bottom: var(--player-height);
    overflow-y: auto;
    scrollbar-gutter: stable;
  }
</style>
