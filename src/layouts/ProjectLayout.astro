---
/**
 * ProjectLayout — Layout for project detail pages.
 *
 * Extends BaseLayout with project-specific chrome:
 *   - Header band: back link, company·period eyebrow, title, role, tech tags
 *   - MDX body rendered via <slot />
 *   - Each ## heading in MDX gets a content-band section with green divider
 *   - Footer nav: prev/next project links
 *
 * Props:
 *   entry — full collection entry (frontmatter data available)
 *   prev  — previous project entry (or null)
 *   next  — next project entry (or null)
 */

import BaseLayout from './BaseLayout.astro';
import TechIcon from '../components/TechIcon.astro';
import type { CollectionEntry } from 'astro:content';

type ProjectEntry = CollectionEntry<'projects'>;

export interface Props {
  entry: ProjectEntry;
  prev?: ProjectEntry | null;
  next?: ProjectEntry | null;
}

const { entry, prev, next } = Astro.props;
const { data } = entry;

// Format period
function formatDate(d: Date): string {
  return d.toLocaleDateString('es-MX', { year: 'numeric', month: 'short' });
}
const periodStr = data.period.end
  ? `${formatDate(data.period.start)} – ${formatDate(data.period.end)}`
  : `${formatDate(data.period.start)} – presente`;
---}

<BaseLayout title={`${data.title} · portfolio`}>
  <article class="project-detail">
    <!-- ================================================================
         Header band
         ================================================================ -->
    <header class="detail-header">
      <a href="/projects" class="back-link">← proyectos</a>

      <p class="detail-eyebrow">
        {data.company}<span class="eyebrow-sep" aria-hidden="true"> · </span>{periodStr}
      </p>

      <h1 class="detail-title">{data.title}</h1>

      <p class="detail-role">{data.role}</p>
      {data.description && <p class="detail-desc">{data.description}</p>}

      <div class="detail-techs">
        {data.techStack.map((tech) => (
          <span class="tech-pill">
            <TechIcon name={tech} size="sm" />
            <span class="tech-pill-label">{tech}</span>
          </span>
        ))}
      </div>
    </header>

    <!-- ================================================================
         Green divider band
         ================================================================ -->
    <div class="green-divider" aria-hidden="true"></div>

    <!-- ================================================================
         MDX body — rendered content with ## headings
         ================================================================ -->
    <div class="detail-body">
      <slot />
    </div>

    <!-- ================================================================
         Footer nav — prev / next
         ================================================================ -->
    <nav class="detail-nav">
      <div class="nav-item nav-item--prev">
        {prev && (
          <a href={`/projects/${prev.id}`} class="nav-link-prev">
            <span class="nav-arrow">←</span>
            <span class="nav-label">{prev.data.title}</span>
          </a>
        )}
      </div>
      <div class="nav-item nav-item--next">
        {next && (
          <a href={`/projects/${next.id}`} class="nav-link-next">
            <span class="nav-label">{next.data.title}</span>
            <span class="nav-arrow">→</span>
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>

<style>
  /* ========================================================================
     Project Detail — article wrapper
     ======================================================================== */
  .project-detail {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-3xl) var(--space-5xl);
  }

  /* ========================================================================
     Header band
     ======================================================================== */
  .detail-header {
    margin-bottom: var(--space-4xl);
    margin-block-end: var(--space-4xl);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font: var(--text-body-md-strong);
    color: var(--color-primary-soft);
    text-decoration: none;
    margin-bottom: var(--space-lg);
    margin-block-end: var(--space-lg);
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .detail-eyebrow {
    font: var(--text-eyebrow);
    letter-spacing: var(--text-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: var(--space-sm);
    margin-block-end: var(--space-sm);
  }

  .eyebrow-sep {
    color: var(--color-hairline);
    margin: 0 var(--space-xxs);
  }

  .detail-title {
    font: var(--text-display-lg);
    letter-spacing: var(--text-display-lg-tracking);
    color: var(--color-ink);
    margin-bottom: var(--space-md);
    margin-block-end: var(--space-md);
  }

  .detail-role {
    font: var(--text-body-md-strong);
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
    margin-block-end: var(--space-sm);
  }

  .detail-desc {
    font: var(--text-body-lg);
    color: var(--color-body);
    max-width: 65ch;
    margin-bottom: var(--space-lg);
    margin-block-end: var(--space-lg);
  }

  .detail-techs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tech-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--button-pill-tag-padding);
    font: var(--button-pill-tag-typo);
    color: var(--button-pill-tag-text);
    background: var(--button-pill-tag-bg);
    border: 1px solid var(--button-pill-tag-border);
    border-radius: var(--button-pill-tag-rounded);
  }

  .tech-pill-label {
    font: var(--text-body-sm);
    color: var(--color-ink);
  }

  /* ========================================================================
     Green divider band — 2px solid primary
     ======================================================================== */
  .green-divider {
    height: 2px;
    background: var(--color-primary);
    border: none;
    margin-bottom: var(--space-4xl);
    margin-block-end: var(--space-4xl);
  }

  /* ========================================================================
     MDX body — content-band sections
     ======================================================================== */
  .detail-body {
    /* MDX headings map to content-band sections with green divider separators */
    margin-bottom: var(--space-4xl);
    margin-block-end: var(--space-4xl);
  }

  .detail-body :global(h2) {
    font: var(--text-display-md);
    letter-spacing: var(--text-display-md-tracking);
    color: var(--color-ink);
    margin-top: var(--space-5xl);
    margin-bottom: var(--space-lg);
    margin-block: var(--space-5xl) var(--space-lg);
    padding-top: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-top: 2px solid var(--color-primary);
  }

  .detail-body :global(h2:first-child) {
    margin-top: 0;
    margin-block-start: 0;
  }

  .detail-body :global(h3) {
    font: var(--text-display-sm);
    font-weight: 600;
    color: var(--color-ink);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    margin-block: var(--space-2xl) var(--space-md);
  }

  .detail-body :global(p) {
    font: var(--text-body-md);
    color: var(--color-body);
    max-width: 65ch;
    line-height: 1.75;
    margin-bottom: var(--space-lg);
    margin-block-end: var(--space-lg);
  }

  .detail-body :global(ul),
  .detail-body :global(ol) {
    font: var(--text-body-md);
    color: var(--color-body);
    margin-bottom: var(--space-lg);
    margin-block-end: var(--space-lg);
    padding-inline-start: 1.5em;
  }

  .detail-body :global(li) {
    margin-bottom: var(--space-sm);
    margin-block-end: var(--space-sm);
  }

  .detail-body :global(pre) {
    background: var(--code-mockup-bg);
    border: 1px solid var(--code-mockup-border);
    border-radius: var(--code-mockup-rounded);
    padding: var(--code-mockup-padding);
    font: var(--code-mockup-typo);
    overflow-x: auto;
    margin-bottom: var(--space-2xl);
    margin-block-end: var(--space-2xl);
  }

  .detail-body :global(code) {
    font-family: var(--font-mono);
    font: var(--text-code);
  }

  .detail-body :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-lg);
    padding-inline-start: var(--space-lg);
    margin-left: 0;
    margin-inline-start: 0;
    color: var(--color-mute);
    font-style: italic;
  }

  /* ========================================================================
     Footer nav — prev / next
     ======================================================================== */
  .detail-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-3xl);
    padding-block-start: var(--space-3xl);
    border-top: 1px solid var(--color-hairline);
  }

  .nav-item {
    flex: 1;
  }

  .nav-item--next {
    text-align: right;
  }

  .nav-link-prev,
  .nav-link-next {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font: var(--text-body-md-strong);
    color: var(--color-primary-soft);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link-prev:hover,
  .nav-link-next:hover {
    color: var(--color-primary);
  }

  .nav-arrow {
    font-size: 1.2em;
  }

  .nav-label {
    max-width: 28ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ========================================================================
     Responsive
     ======================================================================== */
  @media (max-width: 768px) {
    .project-detail {
      padding: var(--space-2xl) var(--space-lg) var(--space-4xl);
    }

    .detail-title {
      font-size: 28px;
      line-height: 34px;
    }

    .detail-nav {
      flex-direction: column;
      gap: var(--space-md);
    }

    .nav-item--next {
      text-align: left;
    }
  }

  /* ========================================================================
     Desktop — ≥1024px: wider content area, larger display
     ======================================================================== */
  @media (min-width: 1024px) {
    .project-detail {
      max-width: 1100px;
      padding: var(--space-5xl) var(--space-3xl) var(--space-6xl);
    }

    .detail-title {
      font-size: 42px;
      line-height: 48px;
      max-width: 18ch;
    }

    .detail-desc {
      font-size: 20px;
      line-height: 32px;
    }

    .detail-body :global(p) {
      max-width: 70ch;
    }

    .detail-body :global(pre) {
      max-width: 100%;
    }
  }
</style>
