---
import { ClientRouter } from 'astro:transitions';

// Self-hosted fonts
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

// Global styles
import '../styles/tokens.css';
import '../styles/global.css';

// Components
import Nav from '../components/Nav.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'backend engineer · portfolio', description = 'Backend engineer specializing in distributed systems, clean architecture, and serverless.' } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- View Transitions -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Nav />

    <main transition:animate="slide">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-prompt">$</span>
        <span class="footer-text">./portfolio --built-with &copy; {new Date().getFullYear()}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    padding: var(--space-lg) var(--content-padding);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xl);
  }

  .footer-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono-stack);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .footer-prompt {
    color: var(--color-text-accent);
  }
</style>
