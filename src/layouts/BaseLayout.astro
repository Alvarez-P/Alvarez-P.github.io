---
import { ClientRouter } from 'astro:transitions';

// Self-hosted fonts — Inter (400, 500, 600, 700) + JetBrains Mono (400, 500)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

// Global styles — tokens first, then base
import '../styles/tokens.css';
import '../styles/global.css';

// Components
import Nav from '../components/Nav.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'backend engineer · portfolio',
  description = 'Backend engineer specializing in distributed systems, clean architecture, and serverless.',
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- View Transitions -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <Nav />

    <main transition:animate="slide">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-cr">© {new Date().getFullYear()}</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span class="footer-text">gentleman programming</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-text);
    font: var(--footer-typo);
    padding: var(--footer-padding);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
  }

  .footer-cr,
  .footer-text {
    color: var(--color-mute);
  }

  .footer-sep {
    color: var(--color-hairline);
  }
</style>
