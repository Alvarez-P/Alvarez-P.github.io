---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="space-y-3" data-reveal>
  <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">{eyebrow}</p>
  <h2 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">{title}</h2>
  {description && <p class="max-w-2xl text-base text-muted-foreground">{description}</p>}
</div>
