---
const currentPath = Astro.url.pathname;

interface NavLink {
  href: string;
  label: string;
}

const links: NavLink[] = [
  { href: '/', label: 'inicio' },
  { href: '/projects', label: 'proyectos' },
  { href: '/about', label: 'about' },
  { href: '/contact', label: 'contacto' },
];
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Inicio">
      <span class="nav-brand-text">gentleman<span class="nav-brand-accent">.</span>dev</span>
    </a>

    <ul class="nav-links">
      {links.map((link) => {
        const isActive =
          currentPath === link.href ||
          (link.href !== '/' && currentPath.startsWith(link.href));

        return (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-link--active': isActive }]}
            >
              {isActive ? (
                <span class="nav-indicator" aria-hidden="true"></span>
              ) : null}
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-overlay);
    background: var(--nav-bar-bg);
    border-bottom: 1px solid var(--color-hairline);
  }

  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--nav-bar-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    text-decoration: none;
    display: flex;
    align-items: center;
    font: var(--text-body-md-strong);
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .nav-brand:hover {
    color: var(--color-primary);
  }

  .nav-brand-accent {
    color: var(--color-primary);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-xxs);
    padding: var(--space-xs) var(--space-sm);
    font: var(--nav-link-typo);
    color: var(--nav-link-text);
    text-decoration: none;
    border-radius: var(--rounded-sm);
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-ink);
  }

  .nav-link--active {
    color: var(--color-ink);
  }

  /* Active indicator: green underline/dot per ex-app-shell-row pattern */
  .nav-indicator {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: var(--rounded-full);
    background-color: var(--color-primary);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .nav-inner {
      padding: var(--space-sm) var(--space-lg);
    }

    .nav-links {
      gap: var(--space-xxs);
    }

    .nav-link {
      padding: var(--space-xxs) var(--space-xs);
    }
  }
</style>
