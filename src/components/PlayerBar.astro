---
export interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'Perfil', subtitle = 'Adolfo Esteban Alvarez Pacheco' } = Astro.props;
---

<footer class="player-bar">
  <div class="player-track">
    <div class="player-album">
      <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" class="album-mini-svg">
        <rect width="44" height="44" rx="4" fill="url(#pm)"/>
        <defs><linearGradient id="pm" x1="0" y1="0" x2="44" y2="44"><stop offset="0%" stop-color="#1ed760"/><stop offset="100%" stop-color="#0d5c2e"/></linearGradient></defs>
        <g fill="#fff" opacity="0.25"><circle cx="12" cy="12" r="3"/><circle cx="22" cy="22" r="4"/><circle cx="34" cy="10" r="2"/></g>
        <g stroke="#fff" stroke-width="0.5" opacity="0.15"><line x1="12" y1="12" x2="22" y2="22"/><line x1="22" y1="22" x2="34" y2="10"/></g>
      </svg>
    </div>
    <div class="player-info">
      <span class="player-title">{title}</span>
      <span class="player-artist">{subtitle}</span>
    </div>
    <button class="player-like" id="player-like" aria-label="Guardar">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M8 13.4L2.8 8.6C1.7 7.5 1.7 5.7 2.8 4.6C3.9 3.5 5.7 3.5 6.8 4.6L8 5.8L9.2 4.6C10.3 3.5 12.1 3.5 13.2 4.6C14.3 5.7 14.3 7.5 13.2 8.6L8 13.4Z"/>
      </svg>
    </button>
  </div>

  <div class="player-controls">
    <button class="ctrl-btn" id="ctrl-prev" aria-label="Anterior">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <rect x="11" y="3" width="2.5" height="10" rx="1"/>
        <polygon points="10,3 2,8 10,13"/>
      </svg>
    </button>
    <button class="ctrl-btn ctrl-play" id="player-play" aria-label="Reproducir">
      <svg class="play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <svg class="pause-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none">
        <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
      </svg>
    </button>
    <button class="ctrl-btn" id="ctrl-next" aria-label="Siguiente">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
        <rect x="2.5" y="3" width="2.5" height="10" rx="1"/>
        <polygon points="6,3 14,8 6,13"/>
      </svg>
    </button>
  </div>

  <div class="player-extra">
    <span class="player-time" id="player-elapsed">0:00</span>
    <div class="progress-bar" id="progress-bar" role="slider" aria-label="Progreso" tabindex="0">
      <div class="progress-fill" id="progress-fill"></div>
      <div class="progress-thumb"></div>
    </div>
    <span class="player-time">∞</span>
  </div>
</footer>

<style>
  .player-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--player-height);
    background: rgba(24, 24, 24, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255,255,255,0.06);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 var(--space-lg);
    z-index: 20;
  }

  .player-track { display: flex; align-items: center; gap: var(--space-md); }

  .player-album {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    transition: transform 0.3s ease;
    overflow: hidden;
  }

  .album-mini-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .player-album:hover { transform: scale(1.08); }

  .player-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

  .player-title {
    font: var(--text-body-sm);
    color: var(--spotify-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
  }

  .player-title:hover { color: var(--spotify-green); text-decoration: underline; }

  .player-artist {
    font: var(--text-body-xs);
    color: var(--spotify-text-subdued);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player-like {
    background: none;
    border: none;
    color: var(--spotify-green);
    cursor: pointer;
    padding: var(--space-xs);
    border-radius: var(--radius-sm);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .player-like:hover { transform: scale(1.2); }
  .player-like.liked { color: var(--spotify-green); }
  .player-like.liked svg { fill: var(--spotify-green); }

  .player-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
  }

  .ctrl-btn {
    background: none;
    border: none;
    color: var(--spotify-text-subdued);
    cursor: pointer;
    padding: var(--space-xs);
    transition: color 0.2s ease, transform 0.15s ease;
  }

  .ctrl-btn:hover { color: var(--spotify-text-primary); transform: scale(1.1); }
  .ctrl-btn:active { transform: scale(0.95); }

  .ctrl-play {
    background: var(--spotify-text-primary);
    color: #000000;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .ctrl-play:hover { transform: scale(1.1); color: #000000; }
  .ctrl-play:active { transform: scale(0.95); }

  .player-extra {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-sm);
  }

  .player-time {
    font: var(--text-caption);
    color: var(--spotify-text-subdued);
    min-width: 32px;
    text-align: center;
  }

  .progress-bar {
    width: 120px;
    height: 4px;
    background: var(--spotify-progress-bg);
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    transition: height 0.15s ease;
  }

  .progress-bar:hover { height: 6px; }

  .progress-fill {
    height: 100%;
    background: var(--spotify-text-primary);
    border-radius: 4px;
    width: 0%;
    transition: background 0.2s ease;
  }

  .progress-bar:hover .progress-fill { background: var(--spotify-green); }

  .progress-thumb {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: var(--spotify-text-primary);
    transform: translate(-50%, -50%);
    transition: width 0.15s ease, height 0.15s ease, background 0.2s ease;
  }

  .progress-bar:hover .progress-thumb {
    width: 12px;
    height: 12px;
    background: var(--spotify-green);
  }
</style>

<script>
  // ── Page navigation (prev/next) ─────────────────────────────────
  const pages = ['/', '/experiencia', '/about', '/contact'];

  function setupNav() {
    document.getElementById('ctrl-prev')?.addEventListener('click', () => {
      const current = pages.indexOf(window.location.pathname);
      const prev = current <= 0 ? pages.length - 1 : current - 1;
      window.location.href = pages[prev];
    }, { once: true });

    document.getElementById('ctrl-next')?.addEventListener('click', () => {
      const current = pages.indexOf(window.location.pathname);
      const next = current >= pages.length - 1 ? 0 : current + 1;
      window.location.href = pages[next];
    }, { once: true });
  }

  document.addEventListener('astro:page-load', setupNav);
  setupNav();

  // ── Play/Pause ──────────────────────────────────────────────────
  const playBtn = document.getElementById('player-play');
  const playIcon = playBtn?.querySelector('.play-icon') as HTMLElement;
  const pauseIcon = playBtn?.querySelector('.pause-icon') as HTMLElement;
  let playing = false;

  playBtn?.addEventListener('click', () => {
    playing = !playing;
    if (playing) {
      playIcon.style.display = 'none';
      pauseIcon.style.display = 'block';
      startProgress();
    } else {
      playIcon.style.display = 'block';
      pauseIcon.style.display = 'none';
      stopProgress();
    }
  });

  // ── Progress bar animation ──────────────────────────────────────
  const progressFill = document.getElementById('progress-fill')!;
  const progressThumb = document.querySelector('.progress-thumb') as HTMLElement;
  const elapsedEl = document.getElementById('player-elapsed')!;
  let progressInterval: ReturnType<typeof setInterval> | null = null;
  let progress = 0;

  function startProgress() {
    stopProgress();
    progressInterval = setInterval(() => {
      progress = Math.min(progress + 0.15, 70); // Caps at 70% (infinity at the end)
      progressFill.style.width = progress + '%';
      if (progressThumb) progressThumb.style.left = progress + '%';
      const mins = Math.floor(progress / 60 * 6);
      const secs = Math.floor((progress / 60 * 6 - mins) * 60);
      elapsedEl.textContent = `${mins}:${String(secs).padStart(2, '0')}`;
    }, 500);
  }

  function stopProgress() {
    if (progressInterval) clearInterval(progressInterval);
    progressInterval = null;
  }

  // ── Like button ─────────────────────────────────────────────────
  const likeBtn = document.getElementById('player-like');
  likeBtn?.addEventListener('click', () => {
    likeBtn.classList.toggle('liked');
  });

  // ── Progress bar click to seek ──────────────────────────────────
  const progressBar = document.getElementById('progress-bar');
  progressBar?.addEventListener('click', (e) => {
    if (!playing) return;
    const rect = progressBar.getBoundingClientRect();
    const pct = ((e.clientX - rect.left) / rect.width) * 70; // Max 70%
    progress = pct;
    progressFill.style.width = pct + '%';
    if (progressThumb) progressThumb.style.left = pct + '%';
  });
</script>
